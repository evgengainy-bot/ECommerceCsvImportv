@{
    ViewData["Title"] = "Импорт товаров";
}
<h1>Импорт товаров из CSV</h1>

<form method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label class="form-label">Выберите CSV-файл:</label>
        <input type="file" name="file" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Или укажите путь к файлу на сервере:</label>
        <input type="text" name="filePath" class="form-control" placeholder="например, wwwroot\csv\sample_products.csv" />
    </div>
    <button type="submit" class="btn btn-primary">Импортировать товары</button>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3">@ViewBag.Error</div>
}

@if (ViewBag.Result != null)
{
    var result = (ImportResult)ViewBag.Result;
    <h2 class="mt-4">Результат импорта</h2>
    <table class="table table-bordered" style="max-width: 420px;">
        <tr><td>Всего строк</td><td>@result.TotalRows</td></tr>
        <tr><td>Успешно импортировано</td><td>@result.ImportedCount</td></tr>
        <tr><td>Ошибки</td><td>@result.ErrorCount</td></tr>
    </table>

    if (result.Errors.Count > 0)
    {
        <h3>Список ошибок:</h3>
        <table class="table table-striped">
            <tr><th>Строка</th><th>Описание ошибки</th></tr>
            @foreach (var error in result.Errors)
            {
                <tr><td>@error.RowNumber</td><td>@error.Message</td></tr>
            }
        </table>
    }

    <a class="btn btn-secondary" asp-controller="Products" asp-action="Index">Перейти к списку товаров</a>
}
